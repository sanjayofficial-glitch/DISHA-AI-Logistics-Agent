# DISHA — environment template. Placeholder values only; never commit real keys.

# --- Service ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM providers (optional; demo mode when both empty) --------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Supabase (optional; SQLite demo store when empty) ----------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Auth — Clerk->Supabase JWT contract -------------------------------------
# SUPABASE_JWT_SECRET is highly sensitive: it can sign JWTs. In demo mode
# (no value) a dev-only fallback secret is used and /auth/demo-login is
# enabled — never in production. Setting SUPABASE_URL + SUPABASE_ANON_KEY
# or SUPABASE_JWT_SECRET disables /auth/demo-login. ENVIRONMENT=production
# requires issuer, audience AND a real JWT secret (startup fails otherwise).
SUPABASE_JWT_SECRET=
CLERK_EXPECTED_ISSUER=
CLERK_EXPECTED_AUDIENCE=

# --- CORS -------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Storage / limits -------------------------------------------------------
DB_PATH=data/disha.db
